{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume|fork",
        "hooks": [
          { "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/logbook-brief.py\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/logbook-gate.py\"" }
        ]
      }
    ]
  }
}
