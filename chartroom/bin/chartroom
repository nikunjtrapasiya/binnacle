#!/usr/bin/env python3
"""chartroom: one page over logbook and hail.

Reads both siblings over their documented --json output, joins what is
owed to the sessions that worked it, and writes one self-contained HTML
page. Read-only against both.
"""
import copy
import datetime
import hmac
import html
import http.server
import json
import os
import secrets
import shlex
import subprocess
import sys
import tempfile
import urllib.parse
import webbrowser

VERSION = "0.4.3"
CONFIG_VERSION = 1
# Per tool, because they move apart. logbook 0.3.0 is the release that
# reports its own kinds, and without that this page cannot say which
# obligations block and which are only on record.
SIBLING_FLOOR = {"logbook": (0, 3, 0), "hail": (0, 2, 0)}

DEFAULTS = {
    "version": 1,
    "page": {
        "path": "~/.claude/binnacle/chartroom/chartroom.html",
        "open": True,
    },
    "sort": {"by": "age", "dir": "asc"},
    "rows": {"only_open": True, "blocking_only": True},
    "sessions": {"limit": 60},
    "serve": {"port": 8787, "open": True},
    "tools": {
        "logbook": "logbook",
        "hail": "hail",
        "timeout_seconds": 20,
    },
}

SORT_KEYS = ("key", "open", "sessions", "age")
SORT_DIRS = ("asc", "desc")


class Refused(Exception):
    """Carries the exit code chartroom should return."""

    def __init__(self, code, message):
        Exception.__init__(self, message)
        self.code = code


def account_home():
    """The account's own home from passwd, not whatever HOME says.

    No expanduser fallback, because the config this locates names the
    executables chartroom runs. A repointed HOME would let anything
    that can set an environment variable choose the binary. Both
    siblings draw the same boundary; a boundary with a HOME-shaped
    fallback is not one.
    """
    try:
        import pwd
        return os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir)
    except Exception as exc:
        raise Refused(2, "cannot resolve the account home: %s" % exc)


def expand_home(path):
    return os.path.expanduser(path)


def config_path():
    return os.path.expanduser("~/.claude/binnacle/chartroom.json")


def config_is_trusted(path):
    """Whether this config may choose the binaries chartroom runs.

    tools.* names an executable, so honouring it from a file outside
    the account's own home would let anything that can set HOME, or
    plant a symlink on the path, choose what runs. Everything else in
    the config only shapes a page and is honoured wherever it is
    found; both siblings draw the same line in the same place.
    """
    try:
        home = account_home()
    except Refused:
        return False
    real = os.path.realpath(path)
    return real == home or real.startswith(home + os.sep)


def type_ok(value, default):
    """Same shape as the default. A default of None also accepts a
    plain int - that slot's absence is itself a meaningful setting,
    not just unset."""
    if default is None:
        return value is None or (
            isinstance(value, int) and not isinstance(value, bool))
    if isinstance(default, bool):
        return isinstance(value, bool)
    if isinstance(default, int):
        return isinstance(value, int) and not isinstance(value, bool)
    return isinstance(value, type(default))


def load_config(path=None):
    cfg = copy.deepcopy(DEFAULTS)
    source = {"path": path or config_path(), "fatal": None, "warnings": []}
    try:
        with open(source["path"]) as fh:
            raw = json.load(fh)
    except FileNotFoundError:
        return cfg, source
    except (OSError, ValueError) as exc:
        source["fatal"] = "config is unreadable: %s: %s" % (
            source["path"], exc)
        return cfg, source
    if not isinstance(raw, dict):
        source["fatal"] = "config is not an object: %s" % source["path"]
        return cfg, source
    if raw.get("version") != CONFIG_VERSION:
        source["fatal"] = ("config version %r is not %d: %s"
                           % (raw.get("version"), CONFIG_VERSION,
                              source["path"]))
        return cfg, source
    for key, value in raw.items():
        if key == "version":
            continue
        if key not in cfg:
            source["warnings"].append("unknown config key ignored: %s" % key)
            continue
        if not isinstance(value, dict):
            source["warnings"].append(
                "config key %s must be an object, keeping the default"
                % key)
            continue
        for sub, subvalue in value.items():
            if sub not in cfg[key]:
                source["warnings"].append(
                    "unknown config key ignored: %s.%s" % (key, sub))
                continue
            if not type_ok(subvalue, cfg[key][sub]):
                source["warnings"].append(
                    "config key %s.%s has the wrong type, keeping the "
                    "default" % (key, sub))
                continue
            cfg[key][sub] = subvalue
    named = [t for t in ("logbook", "hail")
             if (raw.get("tools") or {}).get(t)]
    if named and not config_is_trusted(source["path"]):
        for tool in named:
            cfg["tools"][tool] = DEFAULTS["tools"][tool]
        source["warnings"].append(
            "tools.%s ignored: %s is not inside the account's own home, "
            "so it may not choose which binaries run"
            % (", tools.".join(named), source["path"]))
    return cfg, source


CFG, CONFIG_SOURCE = load_config()


def _command(tool):
    """The binary to run for a sibling.

    A bare name goes through PATH. An absolute path is the operator
    saying exactly which file they mean. A relative path resolves
    against whatever directory chartroom was started in, which is a
    repository often enough to be worth refusing outright.
    """
    command = CFG["tools"][tool]
    if os.sep in command and not os.path.isabs(command):
        raise Refused(2, "tools.%s is a relative path: %s. Use a bare "
                         "name to search PATH, or an absolute path."
                      % (tool, command))
    return command


def _run(tool, args):
    try:
        return subprocess.run(
            [_command(tool)] + args,
            capture_output=True, text=True,
            timeout=CFG["tools"]["timeout_seconds"])
    except FileNotFoundError:
        raise Refused(4, "%s is not on PATH. A marketplace install puts "
                         "it on PATH inside a Claude Code session only, "
                         "so from a plain terminal set tools.%s in %s to "
                         "its absolute path. If it is not installed at "
                         "all: /plugin install %s@binnacle"
                      % (tool, tool, CONFIG_SOURCE["path"], tool))
    except subprocess.TimeoutExpired:
        raise Refused(5, "%s did not answer within %ds. Raise "
                         "tools.timeout_seconds in %s, or check whether "
                         "%s is stuck."
                      % (tool, CFG["tools"]["timeout_seconds"],
                         CONFIG_SOURCE["path"], tool))


def _parse_version(text):
    """The first line of stdout, or None.

    Pinned rather than guessed: a builder choosing their own grammar
    here is a builder deciding which installations chartroom refuses.
    """
    first = (text or "").strip().splitlines()
    if not first:
        return None
    parts = first[0].strip().split(".")
    if len(parts) != 3 or not all(p.isdigit() for p in parts):
        return None
    return tuple(int(p) for p in parts)


def check_version(tool):
    floor = SIBLING_FLOOR[tool]
    out = _run(tool, ["--version"])
    got = _parse_version(out.stdout) if out.returncode == 0 else None
    if got is None or got < floor:
        raise Refused(4, "%s is older than %s, or cannot report a "
                         "version. Upgrade it: /plugin update %s@binnacle"
                      % (tool, ".".join(str(n) for n in floor), tool))
    return got


# What each envelope must carry for the page to mean anything. The
# version check is a floor with no ceiling, so without this a future
# sibling that renames a key parses fine and renders "0 open" - the
# worst available answer from a tool whose whole claim is what is
# outstanding, and indistinguishable from an empty ledger.
ENVELOPE = {
    "logbook": (("entries", list), ("thresholds", dict), ("kinds", dict)),
    "hail": (("sessions", list), ("census", dict)),
}


def read_sibling(tool):
    out = _run(tool, ["ls", "--json"])
    if out.returncode != 0:
        raise Refused(4, "%s ls --json exited %d: %s"
                         % (tool, out.returncode, out.stderr.strip()))
    try:
        body = json.loads(out.stdout)
    except ValueError:
        raise Refused(5, "%s ls --json did not return JSON" % tool)
    if not isinstance(body, dict):
        raise Refused(5, "%s ls --json returned %s, not an object"
                      % (tool, type(body).__name__))
    for name, kind in ENVELOPE[tool]:
        if name not in body:
            raise Refused(5, "%s ls --json carries no %s. This chartroom "
                             "cannot read that envelope: upgrade "
                             "chartroom." % (tool, name))
        if not isinstance(body[name], kind):
            raise Refused(5, "%s ls --json gave %s as %s, not %s"
                          % (tool, name, type(body[name]).__name__,
                             kind.__name__))
    return body


def read_sibling_checked(tool):
    """--version, then the envelope. Never matches on message text -
    the exit status of --version is the whole detection, per spec 3.4.
    """
    version = check_version(tool)
    return version, read_sibling(tool)


def _version_text(version):
    return ".".join(str(n) for n in version)


def _fetch_both():
    """The versions come back with the bodies because the masthead
    states which siblings produced the page. Reading them a second time
    would be a second pair of subprocesses answering a question the
    version check already asked."""
    logbook_version, logbook_body = read_sibling_checked("logbook")
    hail_version, hail_body = read_sibling_checked("hail")
    versions = {"logbook": _version_text(logbook_version),
                "hail": _version_text(hail_version)}
    return versions, logbook_body, hail_body


# ---------------------------------------------------------------------
# The join
# ---------------------------------------------------------------------

# A session or entry with none of the four levels present. Named rather
# than [], because both key functions must reach a bucket and an empty
# list would drop the record from the page silently.
UNKEYED = ("unkeyed", "", "")

# A branch name that names no particular work. Two checkouts sitting on
# main are not one work item, and "HEAD" is what a detached checkout
# reports, so it collides across every repository at once.
UNSCOPED_BRANCHES = frozenset(("HEAD", "main", "master", "develop",
                               "trunk"))

# logbook halves an oversized field and marks the cut. A truncated
# repo_path names a directory that does not exist, so keying on it
# mints a phantom row instead of joining the real one.
TRUNCATED = "..."


def _norm_path(path):
    if not isinstance(path, str) or not path.strip():
        return None
    if path.endswith(TRUNCATED):
        return None
    return os.path.normpath(path.strip()) or None


def repo_roots(entries):
    """Every checkout root logbook named.

    Only logbook knows a root, because only logbook asks git. hail
    records the directory a session was launched from, which is as
    often a subdirectory of one.
    """
    roots = set()
    for entry in entries:
        root = _norm_path(entry.get("repo_path"))
        if root:
            roots.add(root)
    return roots


def place_of(path, roots):
    """The checkout a path belongs to, or the path itself.

    The longest matching root wins, so a checkout nested inside another
    keeps its own identity rather than dissolving into its parent.
    """
    clean = _norm_path(path)
    if clean is None:
        return None
    best = None
    for root in roots:
        if clean == root or clean.startswith(root + os.sep):
            if best is None or len(root) > len(best):
                best = root
    return best or clean


def _scope(place):
    """The scope half of a weak key.

    A record with no knowable checkout scopes to "?" rather than to the
    empty string, so it groups with its own kind instead of silently
    joining every other placeless record.
    """
    return place if place else "?"


def _ticket_keys(record):
    """Branch-derived tickets only.

    hail also records a ticket merely mentioned in a prompt, and a row
    claiming "these sessions worked this" must not collect a session
    that only talked about it.
    """
    if record.get("tickets_from_branch"):
        return [("ticket", "", t) for t in record["tickets_from_branch"]
                if t]
    if record.get("ticket"):
        return [("ticket", "", record["ticket"])]
    return []


def _pr_numbers(record):
    numbers = []
    if record.get("pr") is not None:
        numbers.append(str(record["pr"]))
    for pr in record.get("prs") or []:
        if pr.get("number") is not None:
            numbers.append(str(pr["number"]))
    return numbers


def _branch_names(record):
    names = []
    if record.get("branch"):
        names.append(record["branch"])
    names.extend(b for b in record.get("branches") or [] if b)
    return [b for b in names if b not in UNSCOPED_BRANCHES]


def weak_values(record):
    for number in _pr_numbers(record):
        yield ("pr", number)
    for name in _branch_names(record):
        yield ("branch", name)


def ambiguous_values(records, roots):
    """Weak values that name different work in different checkouts.

    A PR number is unique only inside its repository and a branch name
    only inside its checkout, so in principle both want scoping. In
    practice scoping every one of them splits a work item whenever a
    record cannot name its checkout, which is every obligation written
    outside a repository and every session hail saw no cwd for. So
    scope only what is actually ambiguous here: a value that turns up
    under two different checkouts in this very dataset.
    """
    places = {}
    for record in records:
        place = place_of(record.get("repo_path") or record.get("cwd"),
                         roots)
        if place is None:
            continue
        for value in weak_values(record):
            places.setdefault(value, set()).add(place)
    return set(value for value, seen in places.items() if len(seen) > 1)


def named_prs(entries):
    """Every PR number an obligation carries.

    The ledger is the only side that says what a PR means to this
    person: a session's PR comes from the harness, which stamps one on
    its own and gets it wrong. One session here carried 720 records
    claiming a PR merged months earlier on somebody else's branch.
    """
    return frozenset(str(e["pr"]) for e in entries
                     if e.get("pr") is not None)


def _pr_keys(record, place, ambiguous, named=None):
    """PR keys, minus the ones no obligation ever names.

    A PR nothing is owed against is not evidence of what a session
    worked on, and at full rank one false claim outranks the branch and
    carries the session off its own work item - the obligations left
    with no session, the PR with no obligations. `named` is None where
    there is no ledger to ask, which keeps every PR.
    """
    numbers = _pr_numbers(record)
    if named is not None:
        numbers = [n for n in numbers if n in named]
    return [("pr", _scope(place) if ("pr", n) in ambiguous else "", n)
            for n in numbers]


def _branch_keys(record, place, ambiguous):
    return [("branch",
             _scope(place) if ("branch", b) in ambiguous else "", b)
            for b in _branch_names(record)]


def _dir_keys(place):
    return [("dir", "", place)] if place else []


def all_keys(record, roots, ambiguous=frozenset(), named=None):
    """Every level a record answers at, strongest first.

    Collected rather than stopping at the first: the levels a record
    can answer at are what witness an alias, and a record answering at
    two levels is the only evidence that those two levels name one
    piece of work.
    """
    place = place_of(record.get("repo_path") or record.get("cwd"), roots)
    return (_ticket_keys(record) + _pr_keys(record, place, ambiguous, named)
            + _branch_keys(record, place, ambiguous) + _dir_keys(place))


def build_alias(records, roots, ambiguous=frozenset(), named=None):
    """Weak keys bound to the ticket a record witnessed them beside.

    One hop, never a closure: a transitive merge would let one session
    that glanced at a second ticket weld two work items together for
    good, and every later session on either would widen the weld. A
    weak key seen beside two different tickets binds to neither, on the
    grounds that a guess here silently merges unrelated work.

    Only a PR or a branch can bind. A directory is a place, not a piece
    of work: many tickets share one checkout, so binding it would sweep
    every unticketed obligation in that checkout into whichever ticket
    a session there happened to name.
    """
    seen = {}
    for record in records:
        keys = all_keys(record, roots, ambiguous, named)
        tickets = [k for k in keys if k[0] == "ticket"]
        if len(tickets) != 1:
            continue
        for key in keys:
            if key[0] not in ("pr", "branch"):
                continue
            seen.setdefault(key, set()).add(tickets[0])
    return {key: next(iter(strong)) for key, strong in seen.items()
            if len(strong) == 1}


def rows_for(record, roots, alias=None, ambiguous=frozenset(), named=None):
    """Every row a record belongs on.

    The strongest level it answers at, and all of that level's keys: a
    branch naming two tickets worked both. Weaker keys resolve through
    the alias first, so an obligation carrying only a PR still meets
    the sessions that knew its ticket.
    """
    keys = all_keys(record, roots, ambiguous, named)
    if not keys:
        return [UNKEYED]
    top = keys[0][0]
    same = [key for key in keys if key[0] == top]
    if top == "ticket" or not alias:
        return same
    return list(dict.fromkeys(alias.get(key, key) for key in same))


def _row_label(key, repo_for_pr):
    via, _place, raw = key
    if via == "pr":
        return "%s#%s" % (repo_for_pr, raw) if repo_for_pr else "#%s" % raw
    if via == "unkeyed":
        return "unkeyed"
    return raw


def _sort_value(row, by):
    if by == "key":
        return row["key"]
    if by == "open":
        return len(row["obligations"])
    if by == "sessions":
        return len(row["sessions"])
    if by == "age":
        stamps = [s.get("last_ts") for s in row["sessions"]
                 if s.get("last_ts")]
        # a row with no session timestamp has no age evidence; it sorts
        # as though nothing has ever happened, i.e. oldest
        return max(stamps) if stamps else ""
    return row["key"]


def aside_kinds(logbook_body):
    """The kinds logbook says do not block, by name.

    Only an explicit False sets a kind aside. A kind logbook does not
    declare, or declares in a shape this cannot read, stays in front of
    the reader: the page's whole claim is what is outstanding, so the
    safe side of not knowing is to show it.
    """
    if not CFG["rows"]["blocking_only"]:
        return frozenset()
    declared = logbook_body.get("kinds") or {}
    return frozenset(
        name for name, spec in declared.items()
        if isinstance(spec, dict) and spec.get("blocking") is False)


def split_obligations(entries, aside):
    """What blocks, and what is only on record.

    A decision is not work. It was true when it was written and nothing
    arrives to close it, so it accumulates: on the ledger this was built
    against, seven of every ten open entries were decisions and they
    buried the thirty that somebody had to act on.
    """
    front, rest = [], []
    for entry in entries:
        (rest if entry.get("kind") in aside else front).append(entry)
    return front, rest


def build_items(logbook_body, hail_body, built_at=None):
    """Both sides joined into work items, one per distinct key.

    rows_for always returns at least one key (UNKEYED rather than []),
    so every entry and every session lands somewhere.
    """
    entries = logbook_body.get("entries") or []
    sessions = hail_body.get("sessions") or []
    all_session_ids = set(s.get("id") for s in sessions if s.get("id"))

    roots = repo_roots(entries)
    records = list(entries) + list(sessions)
    ambiguous = ambiguous_values(records, roots)
    named = named_prs(entries)
    alias = build_alias(records, roots, ambiguous, named)

    rows = {}

    def row_for(key):
        if key not in rows:
            rows[key] = {"key": key[2], "via": key[0],
                        "obligations": [], "sessions": [],
                        "repo_for_pr": None}
        return rows[key]

    for entry in entries:
        for key in rows_for(entry, roots, alias, ambiguous, named):
            row_for(key)["obligations"].append(entry)

    for rec in sessions:
        for key in rows_for(rec, roots, alias, ambiguous, named):
            row = row_for(key)
            row["sessions"].append(rec)
            if key[0] == "pr":
                for pr in rec.get("prs") or []:
                    if (pr.get("number") is not None
                            and str(pr["number"]) == key[2]
                            and pr.get("repo")):
                        row["repo_for_pr"] = pr["repo"]

    aside = aside_kinds(logbook_body)

    items = []
    for key, row in rows.items():
        aged_out = sum(
            1 for e in row["obligations"]
            if e.get("session") and e["session"] not in all_session_ids)
        row["obligations"].sort(key=lambda e: e.get("ts") or "")
        front, rest = split_obligations(row["obligations"], aside)
        items.append({
            "key": row["key"], "via": row["via"],
            "label": _row_label((row["via"], "", row["key"]),
                                row["repo_for_pr"]),
            "obligations": front,
            "aside": rest,
            "sessions": row["sessions"],
            "aged_out": aged_out,
        })

    by = CFG["sort"]["by"]
    direction = CFG["sort"]["dir"]
    items.sort(key=lambda r: _sort_value(r, by), reverse=(direction == "desc"))
    return items


def only_open_rows(items):
    """Drop the rows that owe nothing, and say how many that was.

    The page answers "what do I owe". A row with sessions and no open
    obligation answers a different question, and on a real ledger they
    are most of the table, so the rows that matter are read past rather
    than read. The count travels back so the masthead can state it: a
    row removed without a word is a page lying by omission.
    """
    if not CFG["rows"]["only_open"]:
        return list(items), 0
    kept = [i for i in items if i["obligations"]]
    return kept, len(items) - len(kept)


def aside_items(items):
    """Every work item that has something on record, carrying only
    that.

    Built from the full list, before only_open_rows has run. An item
    whose obligations are all decisions leaves the page entirely, and
    those decisions are exactly what somebody reopening the ticket in a
    month goes looking for - dropping them with the row would be the
    page destroying the record it exists to keep.
    """
    return [dict(item, obligations=item["aside"], aside=[])
            for item in items if item["aside"]]


def session_list(hail_body):
    """The sessions for the pane, most recent first, and how many were
    left off.

    Not the sessions on the kept rows. "Where was I working" is a
    different question from "what do I owe", and this pane is the one
    that answers it, including for work that owes nothing.

    Capped, because a wide hail window puts hundreds here and a pane
    nobody can reach the bottom of is the crowding this page exists to
    undo. The count travels back so the masthead can state it.
    """
    seen = {}
    for rec in hail_body.get("sessions") or []:
        sid = rec.get("id")
        if sid and sid not in seen:
            seen[sid] = rec
    ordered = sorted(
        seen.values(),
        key=lambda r: (r.get("last_ts") or "", r.get("id") or ""),
        reverse=True)
    limit = CFG["sessions"]["limit"]
    if limit <= 0 or len(ordered) <= limit:
        return ordered, 0
    return ordered[:limit], len(ordered) - limit


def page_meta(logbook_body, hail_body, built_at=None, versions=None):
    thresholds = logbook_body.get("thresholds") or {}
    census = hail_body.get("census") or {}
    return {
        "built_at": built_at or _now_iso(),
        "days": hail_body.get("days"),
        "stale_days": thresholds.get("stale_days"),
        "aged_off": census.get("aged_off") or 0,
        "versions": versions or {},
    }


def _census(items):
    """The masthead's numbers, all derived from the rows themselves.

    Sessions count by id rather than by row: a session keyed under two
    branch tickets sits on two rows and is still one session.
    """
    ids = set()
    by_via = {}
    for item in items:
        by_via[item["via"]] = by_via.get(item["via"], 0) + 1
        for sess in item["sessions"]:
            if sess.get("id"):
                ids.add(sess["id"])
    return {
        "work_items": len(items),
        "by_via": by_via,
        "open": sum(len(i["obligations"]) for i in items),
        "sessions": len(ids),
    }


def _now_iso():
    return datetime.datetime.now(datetime.timezone.utc).strftime(
        "%Y-%m-%dT%H:%M:%SZ")


def _local_stamp(ts):
    """A UTC stamp as the reader's own wall clock, for the masthead.

    Display only. built_at stays UTC in the embedded data, because the
    browser ages every row against it and a localised value would put
    every age out by the offset.

    Unparseable input is returned as given: a masthead with no build
    time at all is worse than one showing a stamp nobody can read.
    """
    if not isinstance(ts, str):
        return ts
    parsed = _parse_stamp(ts)
    if parsed is None:
        return ts
    return parsed.astimezone().strftime("%Y-%m-%d %H:%M %Z")


# ---------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------

# Per session, the section 8 allowlist and nothing else. prompts and
# last_prompt are the highest-sensitivity fields hail holds; path is the
# transcript on disk; project is a mangling of cwd; a PR's url is
# reconstructible and not needed to render a label.
SESSION_ALLOW = ("id", "title", "cwd", "turns", "first_ts", "last_ts",
                 "branches", "tickets_from_branch", "prs")

# Per obligation, the fields the page actually shows. Everything else
# logbook writes (status, repo, why, ...) is redundant with the row it
# is already filed under.
OBLIGATION_ALLOW = ("id", "kind", "ts", "text", "session")


def _obligation_view(entry):
    return dict((k, entry.get(k)) for k in OBLIGATION_ALLOW)


def _session_view(rec):
    view = {}
    for key in SESSION_ALLOW:
        if key == "prs":
            view["prs"] = [{"number": p.get("number"), "repo": p.get("repo")}
                           for p in rec.get("prs") or []]
        elif key in ("branches", "tickets_from_branch"):
            view[key] = rec.get(key) or []
        else:
            view[key] = rec.get(key)
    return view


def _item_view(item):
    return {
        "key": item["key"], "via": item["via"], "label": item["label"],
        "obligations": [_obligation_view(e) for e in item["obligations"]],
        "sessions": [_session_view(s) for s in item["sessions"]],
        "aged_out": item.get("aged_out", 0),
    }


def _embed(payload):
    """JSON for a <script> block.

    `</script>` inside a string ends the block wherever it appears, so
    the escape is on `<` and not on the tag: a branch name is a
    user-controlled string and this is the only thing between it and
    execution.
    """
    return json.dumps(payload, sort_keys=True).replace("<", "\\u003c")


def _esc(value):
    return html.escape(str(value if value is not None else ""), quote=True)


def _drop_fraction(text):
    """The same timestamp without its fractional seconds, offset kept.

    Python 3.9's fromisoformat accepts a 3- or 6-digit fraction and
    nothing else, and neither sibling promises a digit count.
    """
    head, sep, tail = text.partition(".")
    if not sep:
        return None
    for i, char in enumerate(tail):
        if char in "+-":
            return head + tail[i:]
    return head


def _parse_stamp(ts):
    """A timestamp as a datetime, in UTC where it said so, or None.

    Both shapes arrive and both must parse. hail writes a trailing "Z";
    logbook writes a local offset, which is every timestamp in a real
    ledger. A parser that handles only one of them makes staleness
    unreachable rather than wrong, which is the kind of failure that
    reads as "nothing is stale yet".

    Python 3.9's fromisoformat is the constraint: it parses the offset
    but not the "Z", so the "Z" is rewritten into an offset first.
    """
    if not isinstance(ts, str):
        return None
    text = ts.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    parsed = None
    for candidate in (text, _drop_fraction(text)):
        if candidate is None:
            continue
        try:
            parsed = datetime.datetime.fromisoformat(candidate)
            break
        except ValueError:
            continue
    if parsed is None:
        return None
    if parsed.tzinfo is not None:
        parsed = parsed.astimezone(datetime.timezone.utc)
    return parsed


def _parse_date(ts):
    """The calendar date a timestamp falls on, in UTC, or None."""
    parsed = _parse_stamp(ts)
    return None if parsed is None else parsed.date()


def _severity_note(item, stale_days, today):
    """A plain-text hint next to the row: blocked, aging, open or
    nothing.

    Aged against the build's own timestamp, not the clock: the page is
    a build artifact, and a row that quietly turns amber while the file
    sits unopened is describing a build that never happened.
    """
    kinds = set(e.get("kind") for e in item["obligations"])
    if "blocked" in kinds:
        return "blocked"
    if stale_days is not None and today is not None:
        for e in item["obligations"]:
            day = _parse_date(e.get("ts"))
            if day is None:
                continue
            if (today - day).days > stale_days:
                return "aging"
    if item["obligations"]:
        return "open"
    return ""


