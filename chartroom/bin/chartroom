# Wiring lives in one script block rather than on each element: a page
# with hundreds of cards repeats an inline handler hundreds of times,
# and an inline handler is the one thing the page's own
# Content-Security-Policy would have to be loosened for.
_SCRIPT = """
<script>
const items = Array.from(document.querySelectorAll("#items > .item"));
const board = document.getElementById("items");
const cards = Array.from(document.querySelectorAll(".sess"));
const built = Date.parse(CHARTROOM_DATA.built_at);

for (const button of document.querySelectorAll("button.copy")) {
  button.addEventListener("click", function () {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(
        this.previousElementSibling.textContent);
    }
  });
}

// Ages are relative to built_at, never to the reader's clock: the page
// is a build artifact and a page opened next week must still describe
// the build, not silently re-date itself.
for (const cell of document.querySelectorAll(".age")) {
  const ts = Date.parse(cell.getAttribute("data-ts"));
  if (isNaN(ts) || isNaN(built)) { continue; }
  const days = Math.floor((built - ts) / 86400000);
  cell.textContent = days <= 0 ? "today" : days + "d";
}

// One haystack per item and per session, built from the embedded
// record rather than the rendered markup, so the filter reaches a
// field the card chose not to print.
const hay = CHARTROOM_DATA.items.map(function (item) {
  return JSON.stringify(item).toLowerCase();
});
const shay = CHARTROOM_DATA.sessions.map(function (s) {
  return JSON.stringify(s).toLowerCase();
});

function sortValue(index, by) {
  const item = CHARTROOM_DATA.items[index];
  if (by === "key") { return item.key; }
  if (by === "open") { return item.obligations.length; }
  if (by === "sessions") { return item.sessions.length; }
  const stamps = item.sessions.map(function (s) { return s.last_ts; })
    .filter(Boolean).sort();
  return stamps.length ? stamps[stamps.length - 1] : "";
}

const query = document.getElementById("q");
const by = document.getElementById("by");
const dir = document.getElementById("dir");
const shown = document.getElementById("shown");
const empty = document.getElementById("empty");
const chips = Array.from(document.querySelectorAll("button.chip"));
const nosess = document.getElementById("nosess");
const aside = document.getElementById("aside");
const asideSummary = aside ? aside.querySelector("summary") : null;
const asideLabel = asideSummary ? asideSummary.textContent : "";

// Nothing selected means no kind filter at all, which is why the page
// opens whole rather than opening with every chip lit and daring you
// to work out which one to turn off.
function chosen() {
  const on = chips.filter(function (c) {
    return c.getAttribute("data-on") === "1";
  });
  return on.length ? on.map(function (c) {
    return c.getAttribute("data-chip");
  }) : null;
}

// Hides the cards of other kinds and answers whether any survived, so
// a work item holding a deploy and a followup can show the deploy
// alone instead of the item being all-or-nothing.
function keepCards(element, kinds) {
  let kept = 0;
  for (const card of element.querySelectorAll(".card")) {
    const match = !kinds || kinds.indexOf(card.getAttribute("data-kind")) !== -1;
    card.hidden = !match;
    if (match) { kept += 1; }
  }
  return kept;
}

function apply() {
  const kinds = chosen();
  const needle = query.value.trim().toLowerCase();
  const key = by.value;
  const ascending = dir.getAttribute("data-dir") === "asc";
  const order = items.map(function (_, i) { return i; });
  order.sort(function (a, b) {
    const x = sortValue(a, key), y = sortValue(b, key);
    // the original index breaks ties, so a re-sort never reshuffles
    // items that compare equal
    if (x < y) { return ascending ? -1 : 1; }
    if (x > y) { return ascending ? 1 : -1; }
    return a - b;
  });
  let visible = 0;
  const live = {};
  for (const i of order) {
    const kept = keepCards(items[i], kinds);
    const match = (!needle || hay[i].indexOf(needle) !== -1) && kept > 0;
    items[i].hidden = !match;
    if (match) {
      visible += 1;
      for (const e of CHARTROOM_DATA.items[i].obligations) {
        if (e.session) { live[e.session] = true; }
      }
    }
    board.appendChild(items[i]);
  }
  // the right pane follows the same filter: a search that leaves the
  // sessions untouched is a page half-answering the question. Under a
  // kind filter it narrows to the sessions those obligations name,
  // which is the question "who left these" answered without a click.
  let listed = 0;
  cards.forEach(function (card, i) {
    const text = needle ? shay[i].indexOf(needle) !== -1 : true;
    const kind = !kinds || live[CHARTROOM_DATA.sessions[i].id] === true;
    card.hidden = !(text && kind);
    if (!card.hidden) { listed += 1; }
  });
  // the session that left a deploy six weeks ago is past
  // sessions.limit, so a kind filter empties this pane often. An empty
  // column with no words in it reads as a bug.
  if (nosess) {
    nosess.hidden = !(kinds && cards.length > 0 && listed === 0);
  }
  if (aside) {
    const kept = keepCards(aside, kinds);
    aside.hidden = kept === 0;
    if (asideSummary) {
      asideSummary.textContent = kinds
        ? kept + " on record" : asideLabel;
    }
    // picking a kind that only lives in here would otherwise look like
    // an empty page: the matches are behind a closed control
    if (kinds && kept > 0 && visible === 0) { aside.open = true; }
  }
  shown.textContent = visible + " of " + items.length + " shown";
  empty.hidden = visible !== 0 || (aside && !aside.hidden);
}

for (const chip of chips) {
  chip.addEventListener("click", function () {
    const on = this.getAttribute("data-on") === "1";
    if (on) { this.removeAttribute("data-on"); }
    else { this.setAttribute("data-on", "1"); }
    apply();
  });
}

query.addEventListener("input", apply);
by.addEventListener("change", apply);
dir.addEventListener("click", function () {
  const ascending = this.getAttribute("data-dir") === "asc";
  this.setAttribute("data-dir", ascending ? "desc" : "asc");
  this.textContent = ascending ? "descending" : "ascending";
  apply();
});
apply();
</script>
"""


def _masthead(items, meta):
    census = _census(items)
    versions = meta.get("versions") or {}
    line = ["built %s" % _esc(_local_stamp(meta.get("built_at"))),
            "chartroom %s" % _esc(VERSION)]
    for tool in ("logbook", "hail"):
        if versions.get(tool):
            line.append("%s %s" % (tool, _esc(versions[tool])))

    counts = ["%d work item(s)" % census["work_items"]]
    levels = ", ".join("%d %s" % (census["by_via"][v], _esc(v))
                       for v in sorted(census["by_via"]))
    if levels:
        counts.append(levels)
    counts.append("%d open" % census["open"])
    counts.append("%d session(s)" % meta.get("session_count", 0))
    # only where non-zero: a permanent "0 aged off" is a number nobody
    # ever reads, and it hides the one case worth noticing
    if meta.get("aged_off"):
        counts.append("%d aged off" % meta["aged_off"])
    if meta.get("on_record"):
        counts.append("%d on record" % meta["on_record"])
    if meta.get("sessions_dropped"):
        counts.append("%d older session(s) not listed"
                      % meta["sessions_dropped"])
    if meta.get("hidden"):
        counts.append("%d with nothing open hidden" % meta["hidden"])

    return ("<header><h1>chartroom</h1>"
            "<div class=\"meta\">%s</div>"
            "<div class=\"meta\">%s</div></header>"
            % (" &middot; ".join(line), " &middot; ".join(counts)))


def _kind_chips(items, aside):
    """One toggle per kind on this page, with how many there are.

    Built from what was rendered, not from logbook's vocabulary: a chip
    for a kind with nothing behind it is a control whose only possible
    result is an empty page. Nothing starts selected, so the page opens
    whole and the chips are something you reach for, not something you
    have to clear.

    The search box nearly does this and is a trap. Its haystack is the
    whole record, so `deploy` also matches an obligation whose text
    mentions deploying, and it hides whole work items rather than the
    cards inside them.
    """
    counts = {}
    for item in list(items) + list(aside or []):
        for entry in item["obligations"]:
            kind = entry.get("kind")
            if kind:
                counts[kind] = counts.get(kind, 0) + 1
    if len(counts) < 2:
        return ""
    chips = "".join(
        "<button type=\"button\" class=\"chip\" data-chip=\"%s\">"
        "%s <span class=\"n\">%d</span></button>"
        % (_esc(kind), _esc(kind), counts[kind])
        for kind in sorted(counts))
    return "<div class=\"controls chips\" id=\"kinds\">%s</div>" % chips


def _controls():
    """The filter box and the sort controls.

    The select opens on sort.by and the button on sort.dir, so the
    controls describe the order the items are already in rather than
    claiming an order the page does not have.
    """
    options = []
    for key in SORT_KEYS:
        selected = " selected" if key == CFG["sort"]["by"] else ""
        options.append("<option value=\"%s\"%s>%s</option>"
                       % (_esc(key), selected, _esc(key)))
    ascending = CFG["sort"]["dir"] != "desc"
    return ("<div class=\"controls\">"
            "<input id=\"q\" type=\"search\" placeholder=\"filter\" "
            "autocomplete=\"off\">"
            "<label for=\"by\">sort</label>"
            "<select id=\"by\">%s</select>"
            "<button type=\"button\" id=\"dir\" data-dir=\"%s\">%s</button>"
            "<span id=\"shown\"></span></div>"
            % ("".join(options),
               "asc" if ascending else "desc",
               "ascending" if ascending else "descending"))


def _age_span(ts, cls="age"):
    """A stamp the page turns into an age against built_at."""
    return ("<span class=\"%s\" data-ts=\"%s\">%s</span>"
            % (cls, _esc(ts or ""), _esc((ts or "")[:10] or "-")))


def _obligation_card(entry, titles):
    """One obligation, text and all.

    The text is the thing. It used to sit behind a click, which made
    the page something you operated rather than something you read.
    """
    where = ""
    title = titles.get(entry.get("session"))
    if title:
        where = "<div class=\"on\">in %s</div>" % _esc(title)
    return ("<div class=\"card k-%s\" data-kind=\"%s\">"
            "<div class=\"chead\"><b>%s</b>%s</div>"
            "<pre>%s</pre>%s</div>"
            % (_esc(entry.get("kind")), _esc(entry.get("kind")),
               _esc(entry.get("kind")),
               _age_span(entry.get("ts")), _esc(entry.get("text")), where))


def _item_block(item, titles, severity=""):
    sev = ("<span class=\"sev sev-%s\">%s</span>"
           % (_esc(severity), _esc(severity))) if severity else ""
    aged = ("<span class=\"via\">%d aged off</span>" % item["aged_out"]
            ) if item.get("aged_out") else ""
    cards = "".join(_obligation_card(e, titles)
                    for e in item["obligations"])
    return ("<article class=\"item\"><h3>%s"
            "<span class=\"via\">%s</span>%s%s</h3>%s</article>"
            % (_esc(item["label"]), _esc(item["via"]), sev, aged, cards))


def _session_card(sess):
    cwd = sess.get("cwd") or ""
    sid = sess.get("id") or ""
    tags = []
    for ticket in sess.get("tickets_from_branch") or []:
        tags.append("<span class=\"via\">%s</span>" % _esc(ticket))
    for branch in (sess.get("branches") or [])[:1]:
        tags.append("<span class=\"via\">%s</span>" % _esc(branch))
    for pr in sess.get("prs") or []:
        if pr.get("number") is not None:
            tags.append("<span class=\"via\">#%s</span>"
                        % _esc(pr["number"]))
    turns = sess.get("turns")
    if turns is not None:
        tags.append("%s turns" % _esc(turns))
    return ("<div class=\"sess\"><span class=\"stitle\">%s</span>"
            "<div class=\"srow\">%s%s</div>"
            "<code>cd %s &amp;&amp; claude -r %s</code>"
            "<button type=\"button\" class=\"copy\">copy</button></div>"
            % (_esc(sess.get("title") or "(untitled)"),
               "".join(tags), _age_span(sess.get("last_ts")),
               _esc(shlex.quote(cwd)), _esc(sid)))


def render(items, meta, aside=None, sessions=None, dropped=0):
    """One self-contained HTML string. No network resource, no CDN.

    Two panes: what is owed on the left, where it was worked on the
    right. The only thing that varies between two builds of the same
    input is meta["built_at"] - every dict below is written in a fixed
    key order and every list is in the order build_items already fixed,
    so the output is diffable.
    """
    aside = list(aside or [])
    sessions = list(sessions if sessions is not None
                    else _sessions_of(items))
    titles = dict((s.get("id"), s.get("title")) for s in sessions
                  if s.get("id"))

    payload = {
        "built_at": meta.get("built_at"),
        "days": meta.get("days"),
        "stale_days": meta.get("stale_days"),
        "aged_off": meta.get("aged_off"),
        "items": [_item_view(i) for i in items],
        "sessions": [_session_view(s) for s in sessions],
    }
    embedded = _embed(payload)

    stale_days = meta.get("stale_days")
    today = _parse_date(meta.get("built_at"))
    blocks = "".join(
        _item_block(item, titles, _severity_note(item, stale_days, today))
        for item in items)

    on_record = sum(len(i["obligations"]) for i in aside)
    disclosure = ""
    if aside:
        # no empty details element: a control that opens on nothing is
        # a control that should not be there
        disclosure = (
            "<details id=\"aside\"><summary>%d %s on record</summary>%s"
            "</details>"
            % (on_record, "decision" if on_record == 1 else "decisions",
               "".join(_item_block(i, titles) for i in aside)))

    head = dict(meta)
    head["on_record"] = on_record
    head["session_count"] = len(sessions)
    head["sessions_dropped"] = dropped

    session_html = "".join(_session_card(s) for s in sessions)
    if not session_html:
        session_html = ("<p class=\"none\">no sessions in hail\u2019s "
                        "window</p>")

    return "".join([
        # A doctype keeps the browser out of quirks mode, and the
        # charset must be declared rather than sniffed: the page holds
        # whatever the ledger recorded. The policy makes "loads no
        # network resource" something the browser enforces rather than
        # something this file promises; the style and script are the
        # page's own, so allowing them inline costs nothing.
        "<!doctype html>",
        "<html lang=\"en\"><head><meta charset=\"utf-8\">",
        "<meta name=\"viewport\" content=\"width=device-width,"
        "initial-scale=1\">",
        "<meta http-equiv=\"Content-Security-Policy\" content=\""
        "default-src 'none'; style-src 'unsafe-inline'; "
        "script-src 'unsafe-inline'; form-action 'none'; "
        "base-uri 'none'\">",
        "<title>chartroom</title>",
        _STYLE,
        "</head><body>",
        _masthead(items, head),
        _controls(),
        _kind_chips(items, aside),
        "<main><section><h2>obligations &mdash; logbook</h2>"
        "<div id=\"items\">%s</div>"
        "<p id=\"empty\" hidden>no work items match that filter</p>"
        "%s</section>"
        "<section><h2>sessions &mdash; hail</h2>"
        "<div id=\"sessions\">%s</div>"
        "<p id=\"nosess\" hidden>no listed session left any of these. "
        "The ones that did are older than this pane shows.</p>"
        "</section></main>"
        % (blocks, disclosure, session_html),
        "<script>const CHARTROOM_DATA = ", embedded, ";</script>",
        _SCRIPT,
        "</body></html>",
    ])


def _sessions_of(items):
    """The sessions on these items, deduplicated, most recent first.

    Only a fallback for a caller that renders without hail's own list.
    """
    seen = {}
    for item in items:
        for rec in item["sessions"]:
            if rec.get("id") and rec["id"] not in seen:
                seen[rec["id"]] = rec
    return sorted(seen.values(),
                  key=lambda r: (r.get("last_ts") or "", r.get("id") or ""),
                  reverse=True)


def page_target():
    """Where the page goes, refusing what cannot be written.

    Every refusal here is a configuration mistake with an obvious
    correction, so it is worth naming rather than reaching os.makedirs
    and surfacing as a traceback under an exit code that means
    something else.
    """
    raw = CFG["page"]["path"]
    target = expand_home(raw)
    if not os.path.isabs(target):
        raise Refused(2, "page.path must be absolute or start with ~: %s"
                      % raw)
    if os.path.isdir(target):
        raise Refused(2, "page.path is a directory: %s" % target)
    parent = os.path.dirname(target)
    if os.path.exists(parent) and not os.access(parent, os.W_OK):
        raise Refused(2, "page.path is not writable: %s" % parent)
    return target


def write_page(html_text):
    """Atomic, private, and never a partial file.

    mkstemp in the destination directory rather than a fixed .tmp name:
    a fixed name is a handle another process can hold, and a rename
    across filesystems is not atomic.
    """
    target = page_target()
    os.makedirs(os.path.dirname(target), mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target))
    try:
        # utf-8 explicitly, not the locale codec: the page carries
        # whatever the ledger recorded, and a C locale would fail the
        # build on the first character outside ASCII.
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(html_text)
        os.chmod(tmp, 0o600)
        os.replace(tmp, target)
    except BaseException:
        os.unlink(tmp)
        raise
    return target


def _check_sort():
    by = CFG["sort"]["by"]
    direction = CFG["sort"]["dir"]
    if by not in SORT_KEYS or direction not in SORT_DIRS:
        raise Refused(2, "sort.by must be one of %s; sort.dir must be "
                        "one of %s" % (", ".join(SORT_KEYS),
                                       ", ".join(SORT_DIRS)))


def page_html():
    """The whole page as a string, from a fresh read of both siblings.

    Raises Refused for anything a caller should report rather than
    render: bad config, a missing or too-old sibling, one that did not
    answer in time.
    """
    _check_sort()
    versions, logbook_body, hail_body = _fetch_both()
    # One clock for the whole build. Every age on the page is taken
    # against it, so two readouts on one page cannot disagree.
    built_at = _now_iso()
    everything = build_items(logbook_body, hail_body, built_at)
    items, hidden = only_open_rows(everything)
    meta = page_meta(logbook_body, hail_body, built_at=built_at,
                     versions=versions)
    meta["hidden"] = hidden
    listed, dropped = session_list(hail_body)
    return render(items, meta, aside_items(everything), listed, dropped)


def cmd_build(args, open_page):
    if args:
        print("chartroom build: unexpected argument: %s" % args[0],
              file=sys.stderr)
        return 2
    try:
        path = write_page(page_html())
    except Refused as exc:
        print("chartroom: %s" % exc, file=sys.stderr)
        return exc.code
    print(path)
    if open_page:
        try:
            webbrowser.open("file://" + path)
        except Exception:
            pass
    return 0


# ---------------------------------------------------------------------
# serve
#
# A socket where there was only a file. Everything below is about what
# it refuses. The page carries parked work, branch names and the prose
# of every obligation, and until this subcommand the only thing between
# that and another process on this machine was file permissions.

LOOPBACK_HOSTS = frozenset(("127.0.0.1", "localhost", "[::1]", "::1"))


class PageHandler(http.server.BaseHTTPRequestHandler):
    """One path, one method, one caller who knows the token."""

    protocol_version = "HTTP/1.1"
    server_version = "chartroom"
    sys_version = ""
    # a connection that says nothing must not own the socket forever
    timeout = 15

    def _send(self, status, body, content_type="text/plain; charset=utf-8"):
        payload = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(payload)))
        # one request per connection. Keep-alive would leave the
        # handler sitting in a finished connection waiting for a second
        # request that a browser reloading the page never sends there.
        self.send_header("Connection", "close")
        self.close_connection = True
        # the page is rebuilt per request, and the URL carries the
        # token: neither belongs in a cache a later reader can reach
        self.send_header("Cache-Control", "no-store")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(payload)

    def _host_is_loopback(self):
        """The browser sets Host and a page on the open web cannot
        forge it. That is the whole defence against a name on the
        internet resolving to 127.0.0.1 and pointing a victim's browser
        at this socket."""
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0]
        return host in LOOPBACK_HOSTS

    def _authorised(self):
        query = urllib.parse.urlparse(self.path).query
        given = urllib.parse.parse_qs(query).get("t", [""])[0]
        return hmac.compare_digest(given, self.server.token)

    def do_GET(self):
        if not self._host_is_loopback():
            self._send(403, "chartroom serves 127.0.0.1 only\n")
            return
        if not self._authorised():
            self._send(403, "no\n")
            return
        if urllib.parse.urlparse(self.path).path != "/":
            self._send(404, "chartroom serves one page, at /\n")
            return
        try:
            body = page_html()
        except Refused as exc:
            # a refusal is news for the reader, not a stack trace: the
            # sibling that would not answer is named, as the terminal
            # would name it
            self._send(503, "chartroom: %s\n" % exc)
            return
        self._send(200, body, "text/html; charset=utf-8")

    def do_POST(self):
        self._send(405, "chartroom reads. It never writes back.\n")

    do_PUT = do_DELETE = do_PATCH = do_POST

    def log_message(self, fmt, *args):
        """The token lives in the query string, so the query string
        never reaches the log."""
        line = fmt % args
        sys.stderr.write("%s\n" % line.split("?")[0])


class PageServer(http.server.ThreadingHTTPServer):
    """Threaded, so one connection cannot take the page away.

    Any process on this machine can open a socket here and then say
    nothing. Single-threaded, that one connection owns the accept loop
    and the owner's own reload hangs behind it - a local denial of
    service needing no token at all. A thread per connection, plus the
    handler's read timeout, bounds what a silent caller can hold.
    """

    daemon_threads = True
    allow_reuse_address = False

    def __init__(self, address, handler, token):
        http.server.ThreadingHTTPServer.__init__(self, address, handler)
        self.token = token


def build_server(port):
    """Bound, tokened, and loopback only.

    The token is the access control. Every process on this machine can
    reach a loopback port, so binding alone protects nothing; a secret
    in the URL means a process must already be able to read this
    terminal's output to get in.
    """
    if not isinstance(port, int) or isinstance(port, bool) \
            or not 0 <= port <= 65535:
        raise Refused(2, "serve.port must be a port number, not %r" % port)
    try:
        return PageServer(("127.0.0.1", port), PageHandler,
                          secrets.token_urlsafe(32))
    except OSError as exc:
        raise Refused(5, "cannot listen on 127.0.0.1:%d: %s. Another "
                         "chartroom may already be serving; change "
                         "serve.port or stop it." % (port, exc))


def cmd_serve(args, open_page):
    port = CFG["serve"]["port"]
    if args[:1] == ["--port"]:
        if len(args) < 2 or not args[1].isdigit():
            print("chartroom serve: --port takes a number",
                  file=sys.stderr)
            return 2
        port, args = int(args[1]), args[2:]
    if args:
        print("chartroom serve: unexpected argument: %s" % args[0],
              file=sys.stderr)
        return 2
    try:
        _check_sort()
        server = build_server(port)
    except Refused as exc:
        print("chartroom: %s" % exc, file=sys.stderr)
        return exc.code
    url = "http://127.0.0.1:%d/?t=%s" % (server.server_address[1],
                                         server.token)
    # flushed, because serve_forever never returns: stdout is
    # block-buffered into a pipe, and the one line a caller needs would
    # sit in the buffer until the process was killed, taking the token
    # with it
    print(url, flush=True)
    print("rebuilt on every request. ctrl-c to stop.",
          file=sys.stderr, flush=True)
    if open_page:
        try:
            webbrowser.open(url)
        except Exception:
            pass
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("", file=sys.stderr)
    finally:
        server.server_close()
    return 0


def cmd_doctor(args):
    """Settings in force, and the two window findings. Writes nothing.

    Makes the same four calls as build, under the same timeout: a
    doctor reporting on config it had not actually fetched would be the
    wrong kind of quiet.
    """
    if args:
        print("chartroom doctor: unexpected argument: %s" % args[0],
              file=sys.stderr)
        return 2
    print("config: %s (%s)" % (
        CONFIG_SOURCE["path"],
        "exists" if os.path.exists(CONFIG_SOURCE["path"]) else "absent"))
    if CONFIG_SOURCE["fatal"]:
        print("fatal: %s" % CONFIG_SOURCE["fatal"])
        return 4
    for warning in CONFIG_SOURCE["warnings"]:
        print("warning: %s" % warning)
    print("page.path: %s" % CFG["page"]["path"])
    print("page.open: %s" % CFG["page"]["open"])
    print("rows.only_open: %s  rows.blocking_only: %s"
          % (CFG["rows"]["only_open"], CFG["rows"]["blocking_only"]))
    print("sessions.limit: %s" % CFG["sessions"]["limit"])
    print("sort.by: %s  sort.dir: %s"
          % (CFG["sort"]["by"], CFG["sort"]["dir"]))

    try:
        _check_sort()
        versions, logbook_body, hail_body = _fetch_both()
    except Refused as exc:
        print("chartroom: %s" % exc, file=sys.stderr)
        return exc.code

    print("siblings: logbook %s  hail %s"
          % (versions["logbook"], versions["hail"]))
    days = hail_body.get("days") or 0
    print("logbook thresholds: %s"
          % json.dumps(logbook_body.get("thresholds") or {}, sort_keys=True))
    print("hail index.days: %d  census: %s"
          % (days, json.dumps(hail_body.get("census") or {},
                              sort_keys=True)))

    print("logbook kinds: %s" % ", ".join(
        "%s%s" % (name, "" if spec.get("blocking", True) else " (aside)")
        for name, spec in sorted(
            (logbook_body.get("kinds") or {}).items())))

    findings = []
    if CFG["rows"]["blocking_only"] and not aside_kinds(logbook_body):
        findings.append(
            "rows.blocking_only is on and logbook marks no kind "
            "non-blocking, so nothing is ever set aside. Either it is "
            "doing nothing, or a kind that belongs on record is being "
            "shown as work.")
    if days < 30:
        findings.append(
            "index.days is %d. chartroom is a page about what is "
            "owed, and obligations run for months; raise hail's "
            "index.days." % days)

    if not findings:
        print("no findings")
        return 0
    print("findings:")
    for finding in findings:
        print("  %s" % finding)
    return 1


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["--version"]:
        print(VERSION)
        return 0
    command = argv[0] if argv else None
    if CONFIG_SOURCE["fatal"] and command != "doctor":
        print("chartroom: %s" % CONFIG_SOURCE["fatal"], file=sys.stderr)
        return 4
    if command is None:
        return cmd_build([], CFG["page"]["open"])
    if command == "build":
        return cmd_build(argv[1:], False)
    if command == "serve":
        return cmd_serve(argv[1:], CFG["serve"]["open"])
    if command == "doctor":
        return cmd_doctor(argv[1:])
    print("usage: chartroom [build|serve|doctor|--version]",
          file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
